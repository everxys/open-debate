{
  "workflowVersion": 1,
  "enabled": true,
  "phaseMachine": {
    "phases": [
      {
        "id": "phase-1",
        "title": "Phase 1 · 议员实战演练",
        "kind": "analysis",
        "description": "前两轮只做世界规则、胜负结构、人物功能分工与高优先级风险分析，不允许急着收尾。",
        "minRounds": null,
        "injectedPrompt": "【Phase 1】当前仍处于主持人与监管者选举之前的分析阶段。本阶段只能做独立分析、提出候选建议、说明谁适合主持人或监管者以及理由，但禁止正式投票，禁止写“我投谁”，禁止提前宣布谁当选。所有席位现在都还只是议员，真正投票只能等进入 Phase 1.5 后再进行。"
      },
      {
        "id": "phase-1-5",
        "title": "Phase 1.5 · 主持人与监管者选举",
        "kind": "election",
        "description": "用一整轮完成主持人与监管者选举；如果本轮未选出结果，则先回到 Phase 1 补充一轮全员发言，再重新进入本阶段。",
        "minRounds": null,
        "injectedPrompt": "【Phase 1.5】当前是主持人与监管者的正式选举轮。你必须基于前面 Phase 1 已经出现的表现来判断谁适合做主持人、谁适合做监管者，并把判断依据讲清楚。禁止借投票继续推进新设定、新主线或新事件。若本轮无法形成明确结果，下一轮会先回到 Phase 1 继续补充一轮全员发言，然后系统再发起下一次 Phase 1.5 选举。"
      },
      {
        "id": "phase-2",
        "title": "Phase 2 · 动态轮换讨论",
        "kind": "deliberation",
        "description": "用长轮次反复打磨核心诡计、五大事件、人物关系与分卷结构，优先提高点子密度与互锁强度。",
        "minRounds": null
      },
      {
        "id": "phase-2-5",
        "title": "Phase 2.5 · Phase 3 入场表决",
        "kind": "finalization_vote",
        "description": "正式进入 Phase 3 前，先统一判断是否已经具备收束条件，并完成官方入场表决。",
        "minRounds": null,
        "injectedPrompt": "【Phase 2.5】当前是进入 Phase 3 前的正式入场表决阶段。你要先判断：现有争议是否已经收束、关键结构是否已经稳定、主要文件是否具备被汇总的前提。如果支持进入 Phase 3，必须明确说明为什么现在已经成熟；如果反对，也必须明确指出仍未解决的硬缺口。禁止只表态不解释。只有全员同意，下一轮才正式进入 Phase 3。"
      },
      {
        "id": "phase-3",
        "title": "Phase 3 · 共识收敛与最终交付",
        "kind": "finalization",
        "description": "进入章节级扩写、伏笔台账校验、关键场景与终局回收，不满足厚度与密度门槛不得结束。",
        "minRounds": null
      }
    ],
    "transitionRules": {
      "election": {
        "startRound": 3,
        "autoOpen": true,
        "reopenUntilPassed": true,
        "discussionRoundsBetweenVotes": 1
      },
      "finalization": {
        "autoOpenVote": true,
        "requireUnanimousVote": true,
        "reopenUntilPassed": true,
        "discussionRoundsBetweenVotes": 1,
        "requirePhaseForCompletion": true
      }
    }
  },
  "election": {
    "startRound": 3,
    "roles": ["Host", "Supervisor"],
    "speakingOrder": {
      "firstRole": "Host",
      "lastRole": "Supervisor"
    }
  },
  "seatOrderRules": [
    {
      "afterRound": 1,
      "policy": {
        "type": "reverse"
      }
    },
    {
      "afterRound": 2,
      "policy": {
        "type": "reverse"
      }
    }
  ],
  "voting": {
    "custom": {
      "minOptions": 2,
      "maxOptions": null
    },
    "announcement": {
      "announcer": {
        "type": "role",
        "role": "Host"
      },
      "fallback": {
        "type": "seat",
        "seat": 1
      }
    },
    "governance": {
      "tieBreaker": "revote",
      "maxTieRounds": 2,
      "fallbackMode": "逻辑审核员"
    }
  },
  "consensus": {
    "enabled": true,
    "minAvgScore": 8,
    "requireAllSeats": true
  },
  "promptPolicies": {
    "openingPrompt": "整场讨论必须尽量说人话。禁止只丢简短结论、标签或速记句。后发言者的首要任务不是顺着前一个人的结论做轻量补充，而是主动寻找更强、更狠、更完整的替代方案；只要你判断前案不够好，就应该直接提出新方案，必要时可以整体推翻前案并重建。只要提出一个方案、观点或投票理由，都要尽量讲清楚它具体是什么、为什么更强、会带来什么影响，让其他人一眼看懂你的意思。另外，在 Phase 1 和 Phase 1 之前严禁提前投票、严禁写“我投谁”、严禁提前宣布主持人或监管者；那只能在正式进入 Phase 1.5 后发生。",
    "round1Fairness": true,
    "responseFormat": {
      "requireMarkdown": true,
      "forbidRawJson": true
    },
    "outputBudget": {
      "discussionMaxTokens": null,
      "writingMaxTokens": null
    }
  },
  "deliverables": {
    "allowedPaths": ["final/", "outputs/"],
    "requiredFiles": [
      {
        "path": "final/01-core-premise.md",
        "ownerRole": "Host",
        "description": "核心命题、核心卖点、故事承诺、终局震撼来源",
        "minChars": 6000,
        "minMarkdownHeadings": 10,
        "requiredSnippets": ["核心命题", "核心卖点", "故事承诺", "终局震撼"]
      },
      {
        "path": "final/02-world-rules.md",
        "ownerRole": "Host",
        "description": "世界规则、胜负规则、代价系统、游戏边界、破局条件",
        "minChars": 15000,
        "minMarkdownHeadings": 18,
        "requiredSnippets": ["世界规则", "胜负规则", "代价", "破局条件"]
      },
      {
