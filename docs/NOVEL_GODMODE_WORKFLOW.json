{
  "workflowVersion": 1,
  "enabled": true,
  "completion": {
    "mode": "workflow_gate"
  },
  "phaseMachine": {
    "phases": [
      {
        "id": "phase-1",
        "title": "Phase 1 · 议题定向与风险暴露",
        "kind": "analysis",
        "description": "只解决作品命题、世界边界、底层规则、关键失败风险和阶段优先级，不提前进入大规模点子筛选与终稿整合。",
        "minRounds": null,
        "injectedPrompt": "【Phase 1】当前阶段只负责把题目打透，而不是提前写创作圣经细节。固定 Host 负责控流程和限定本轮唯一问题；内容席位要围绕作品承诺、底层规则、主要风险、成功标准和当前最值得优先推进的方向来辩论。此阶段不要提前读未解锁文件，不要急着写角色表、章节表或终稿，也不要把局部小点子伪装成全书方向。最常见的伪推进，是看起来说了很多，实际上既没有明确命题，也没有明确失败风险。"
      },
      {
        "id": "phase-2",
        "title": "Phase 2 · 分块推进与内容锻造",
        "kind": "deliberation",
        "description": "按子任务逐块推进：点子筛选、主线骨架、人物系统、核心事件、关系弧线、终局伏笔、分卷结构、章节展开。",
        "minRounds": null,
        "injectedPrompt": "【Phase 2】当前阶段由固定 Host 宣布本轮唯一子任务，其他席位围绕该子任务推进。优先顺序通常是：点子筛选与重组 -> 主线骨架与终局真相 -> 人物系统 -> 五大核心事件 -> 关系弧线 -> 伏笔回收 -> 分卷结构 -> 章节级展开。单轮只打一个块，不要同时平铺人物、终局、章节、事件。最常见的伪推进，是讨论热闹但没有形成稳定候选结论，也没有把好点子压成可写文件。"
      },
      {
        "id": "phase-2-5",
        "title": "Phase 2.5 · 收束前表决",
        "kind": "finalization_vote",
        "description": "进入最终收束前，判断关键子任务和关键文件是否已经成熟到可以整合。",
        "minRounds": null,
        "injectedPrompt": "【Phase 2.5】当前阶段要判断：关键子任务是否已有稳定候选结论、关键文件是否具备整合前提、是否还存在明显伪强内容、结构性漏洞或无法复盘的硬伤。如果支持进入最终收束，必须说明为什么现在适合整合；如果反对，也必须指出仍未解决的最硬缺口。最常见的伪推进，是把局部漂亮片段误判成已经可以整体收束。"
      },
      {
        "id": "phase-3",
        "title": "Phase 3 · 收束、补洞与最终交付",
        "kind": "finalization",
        "description": "收敛、审查、补洞、回收、交付；重点不再是自由发散，而是清理最弱一笔并确保二刷成立。",
        "minRounds": null,
        "injectedPrompt": "【Phase 3】当前阶段重点是交付文件总检查、当前最弱一笔清除、伏笔与终局回收自检、逻辑闭环与二刷成立性检查、最终总汇总稿整合。Host 负责维持流程和提醒缺口，但不负责替所有人创作内容。不要重新开大规模新坑，不要用临时新设定掩盖旧漏洞。最常见的伪推进，是把“文件数量变多”误当成“质量已经过关”。"
      }
    ],
    "transitionRules": {
      "finalization": {
        "autoOpenVote": false,
        "requireUnanimousVote": true,
        "reopenUntilPassed": true,
        "discussionRoundsBetweenVotes": 1,
        "requirePhaseForCompletion": true
      }
    }
  },
  "voting": {
    "governance": {
      "tieBreaker": "revote",
      "maxTieRounds": 2
    }
  },
  "consensus": {
    "enabled": true,
    "minAvgScore": 8,
    "requireAllSeats": true
  },
  "promptPolicies": {
    "outputBudget": {
      "discussionMaxTokens": null,
      "writingMaxTokens": null
    }
  },
  "contextAccess": {
