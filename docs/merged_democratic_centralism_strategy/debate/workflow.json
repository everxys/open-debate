{
  "workflowVersion": 1,
  "enabled": true,
  "completion": {
    "mode": "workflow_gate"
  },
  "phaseMachine": {
    "phases": [
      {
        "id": "phase-1",
        "title": "Phase 1 · 议员实战演练",
        "kind": "analysis",
        "description": "只解决作品的终极命题、故事承诺、底层规则、关键风险和候选能力暴露；不允许提前进入点子筛选与收尾。",
        "minRounds": null,
        "injectedPrompt": "【Phase 1】当前仍处于主持人与监管者选举之前的分析阶段。当前唯一目标不是写创作圣经细节，而是先把作品的方向、边界、评价标准和失败风险讨论清楚。推荐按以下子任务顺序推进：1）终极命题与故事承诺；2）世界规则、胜负规则、底层限制；3）这类题材最容易失败的地方；4）当前最值得优先打磨的方向；5）谁更适合当 Host / Supervisor 以及理由。当前轮只应推进其中一个子任务，不要一轮里同时讲命题、人物、事件、章节、终局。此阶段严禁正式投票，严禁写“我投谁”，严禁假装已经进入点子筛选。原始点子库在这个阶段不是当前主战场，除非 workflow 已明确解锁，否则不要浪费回合提前尝试读取。"
      },
      {
        "id": "phase-1-5",
        "title": "Phase 1.5 · 主持人与监管者选举",
        "kind": "election",
        "description": "用一整轮完成 Host 与 Supervisor 选举；若未形成结果，则必须先回到 Phase 1 补新的观点、新证据、新取舍，再重启选举。",
        "minRounds": null,
        "injectedPrompt": "【Phase 1.5】当前是 Host 与 Supervisor 的正式选举轮。你必须基于 Phase 1 中真实表现出来的能力来判断：谁更适合整合全局、持续收敛、推动阶段前进；谁更适合找漏洞、拦伪强、阻止低质量收尾。此轮不要借投票继续扩写大量新设定，不要把投票伪装成继续讨论。投票必须附清楚理由，若未形成明确结果，下一轮会先回到 Phase 1 补新的观点、新证据、新取舍，再重新进入选举。"
      },
      {
        "id": "phase-2",
        "title": "Phase 2 · 动态轮换讨论",
        "kind": "deliberation",
        "description": "长轮次分块推进：点子筛选、主线骨架、人物系统、核心事件、关系弧线、终局伏笔、分卷结构、章节展开，默认一次只打一个块。",
        "minRounds": null,
        "injectedPrompt": "【Phase 2】当前是动态轮换讨论阶段。重点不是“继续讨论”，而是按子任务逐块推进创作圣经。主持人每轮必须宣布当前唯一子任务；若主持人没有明确宣布，则默认按以下顺序推进：1）原始点子筛选与重组；2）主线骨架与终局真相；3）七位外来天才与本土天才生态；4）五大核心事件；5）人物弧线 / 纯爱线 / 背叛线 / 宿敌线；6）终局布局链与伏笔回收；7）分卷结构与长篇强度递增；8）章节级展开。单轮只推进当前子任务，不允许为了显得推进多而同时平铺很多块。每次发言最多只允许重点讨论 5 个点子，默认更推荐只打 1 到 3 个最关键的点子。对每个保留或新增点子，都尽量讲清它如何服务主线、替代什么旧方案、别人可能怎样反驳。"
      },
      {
        "id": "phase-2-5",
        "title": "Phase 2.5 · Phase 3 入场表决",
        "kind": "finalization_vote",
        "description": "正式进入 Phase 3 前，必须先判断当前是否真的具备收束资格，不能把局部共识误判为已经成熟。",
        "minRounds": null,
        "injectedPrompt": "【Phase 2.5】当前是进入 Phase 3 前的正式表决阶段。你要先判断：关键子任务是否已经被打到足够稳定，主要文件是否具备整合前提，是否仍存在结构性硬缺口，是否还有明显伪强内容、空泛内容、不可复盘内容。如果支持进入 Phase 3，必须说明为什么现在已经从“继续探索”转成了“适合整合与校验”；如果反对，也必须指出仍未解决的硬缺口。禁止只表态不解释。"
      },
      {
        "id": "phase-3",
        "title": "Phase 3 · 共识收敛与最终交付",
        "kind": "finalization",
        "description": "收敛、审查、补洞、回收、交付。进入本阶段后重点不再是自由发散，而是清理最弱一笔并确保二刷成立。",
        "minRounds": null,
        "injectedPrompt": "【Phase 3】当前是共识收敛与最终交付阶段。此阶段的优先子任务是：1）交付文件总检查；2）当前最弱一笔清除；3）伏笔与终局回收自检；4）逻辑闭环与二刷成立性检查；5）最终总汇总稿整合。不要回到大规模自由发散，不要用新设定掩盖旧漏洞，不要因为快结束了就降低质量标准。你现在更像在做整合、审校、补洞、交付，而不是重新开一场新的泛讨论。"
      }
    ],
    "transitionRules": {
      "election": {
        "startRound": 3,
        "autoOpen": true,
        "reopenUntilPassed": true,
        "discussionRoundsBetweenVotes": 1
      },
      "finalization": {
        "autoOpenVote": true,
        "requireUnanimousVote": true,
        "reopenUntilPassed": true,
        "discussionRoundsBetweenVotes": 1,
        "requirePhaseForCompletion": true
      }
    }
  },
  "election": {
    "startRound": 3,
    "roles": [
      "Host",
      "Supervisor"
    ],
    "speakingOrder": {
      "firstRole": "Host",
      "lastRole": "Supervisor"
    }
  },
  "rolesMeta": {
    "Host": {
      "label": "Host",
      "category": "coordinator",
      "summary": "负责定义当前轮唯一子任务、仲裁分歧、推进阶段前进、统一最终口径并整合成稿；Host 应收敛，不应长期包办全部初稿。",
      "writingPolicy": "coordinate"
    },
    "Supervisor": {
      "label": "Supervisor",
      "category": "reviewer",
      "summary": "负责持续拦下伪高智商、伪伏笔、伪人物成长、空泛堆字和只靠解释成立的高潮；Supervisor 的职责不是泛泛提醒，而是像质量审判者一样指出当前最虚的一笔。",
      "writingPolicy": "review"
    },
    "Specialist": {
      "label": "Specialist",
      "category": "contributor",
      "summary": "负责把讨论真正落成具体文件内容，持续承担事件、人物、伏笔、章节等模块的主写工作，不能只停留在口头建议。",
      "writingPolicy": "contribute"
    }
  },
