DATABASE_URL=postgres://open_debate:open_debate@localhost:5432/open_debate
APP_URL=http://localhost:3000
SESSION_SECRET=replace-this-with-a-long-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Auth / Email (verification codes)
# EMAIL_DELIVERY=console | sendcloud
EMAIL_DELIVERY=console
# Return `debugCode` in API response when sending codes (0/1).
# Note: In production builds, this only returns when EMAIL_DELIVERY=console.
EMAIL_DEBUG_RETURN_CODE=1
# Optional: extra secret for password hashing
PASSWORD_PEPPER=
# Optional: override Node/OpenSSL scrypt max memory (bytes). Increase if you see
# ERR_CRYPTO_INVALID_SCRYPT_PARAMS / "memory limit exceeded" (e.g. 67108864 = 64MiB).
SCRYPT_MAXMEM=67108864
# Optional: override verification code hashing secret
VERIFICATION_CODE_SECRET=

# SendCloud (when EMAIL_DELIVERY=sendcloud)
SENDCLOUD_API_USER=
SENDCLOUD_API_KEY=
SENDCLOUD_FROM=no-reply@your-domain.com
SENDCLOUD_FROM_NAME=Open Debate
# Optional: override endpoint/subject
# SENDCLOUD_API_ENDPOINT=https://api.sendcloud.net/apiv2/mail/send
# SENDCLOUD_SUBJECT=你的验证码
