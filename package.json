{
  "name": "open-debate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate && node scripts/dev-with-summary-worker.cjs",
    "build": "next build",
    "start": "node scripts/ensure-next-build.cjs && npm run db:migrate && next start",
    "worker:summary": "npm run db:migrate && tsx scripts/summary-worker.ts",
    "db:migrate": "tsx scripts/db-migrate.ts up",
    "db:migrate:check": "tsx scripts/db-migrate.ts check",
    "test": "npm run changelog:check && node --import tsx --test tests/**/*.test.ts",
    "changelog:generate": "tsx scripts/changelog.ts generate",
    "changelog:check": "tsx scripts/changelog.ts check",
    "lint": "next lint",
    "migrate:workflow-phase-1-5": "node scripts/migrate-workflow-phase-1-5.cjs",
    "repair:duplicate-turns": "node scripts/repair-duplicate-debate-turns.cjs",
    "repair:idea-bank-shadows": "node scripts/repair-idea-bank-shadows.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@next/env": "^15.5.15",
    "framer-motion": "^11.2.10",
    "jose": "5.9.6",
    "kysely": "^0.28.16",
    "monaco-editor": "^0.55.1",
    "next": "15.5.15",
    "pg": "8.14.1",
    "react": "19.0.0",
    "react-arborist": "^3.4.3",
    "react-dom": "19.0.0",
    "tsx": "^4.21.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.15",
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.15",
    "typescript": "5.8.2"
  },
  "overrides": {
    "dompurify": "3.3.2",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.5"
    },
    "eslint": {
      "minimatch": {
        "brace-expansion": "1.1.13"
      }
    },
    "flat-cache": {
      "flatted": "3.4.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "tinyglobby": {
      "picomatch": "4.0.4"
    },
    "fdir": {
      "picomatch": "4.0.4"
    }
  }
}
